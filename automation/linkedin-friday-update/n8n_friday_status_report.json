      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every Friday 4 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "options": {
          "jql": "assignee = currentUser() AND statusCategory = Done AND resolved >= -7d ORDER BY resolved DESC"
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Jira Done",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [260, 80],
      "alwaysOutputData": true,
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "REPLACE_ME",
          "name": "Jira Software Cloud account"
        }
      }
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "options": {
          "jql": "assignee = currentUser() AND statusCategory != Done ORDER BY priority DESC, updated DESC"
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Jira Open",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [260, 320],
      "alwaysOutputData": true,
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "REPLACE_ME",
          "name": "Jira Software Cloud account"
        }
      }
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Wait For Both",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [520, 200]
    },
    {
      "parameters": {
        "jsCode": "const pick = (items) => items\n  .filter((i) => i.json && i.json.key)\n  .map((i) => {\n    const f = i.json.fields || {};\n    const labels = (f.labels || []).join(', ');\n    const status = f.status && f.status.name ? f.status.name : '';\n    const priority = f.priority && f.priority.name ? f.priority.name : '';\n    return `- ${i.json.key}: ${f.summary || ''} [status: ${status}; priority: ${priority}${labels ? '; labels: ' + labels : ''}]`;\n  });\n\nconst done = pick($('Jira Done').all());\nconst open = pick($('Jira Open').all());\n\nconst prompt = [\n  'Write my Friday status update for my manager.',\n  'Output exactly 3 lines, no greeting, no preamble, no markdown:',\n  'Done: one sentence summarising what shipped this week.',\n  'Next: one sentence on the top priorities for next week.',\n  'Blocked: one sentence on blockers, or \"Nothing blocked.\" if none.',\n  'Treat a ticket as blocked if its status or labels contain \"blocked\" or \"waiting\".',\n  'Be specific, plain, and short. Mention ticket keys only where they add clarity.',\n  '',\n  'TICKETS DONE THIS WEEK:',\n  done.length ? done.join('\\n') : '(none)',\n  '',\n  'TICKETS STILL OPEN:',\n  open.length ? open.join('\\n') : '(none)'\n].join('\\n');\n\nreturn [{ json: { prompt, doneCount: done.length, openCount: open.length } }];"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "x-api-key", "value": "YOURKEY" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-5', max_tokens: 400, messages: [{ role: 'user', content: $json.prompt }] }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Claude Write Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "Friday update",
        "emailType": "text",
        "message": "={{ $json.content[0].text }}",
        "options": {
          "sendTo": "YOUR_MANAGER@example.com"
        }
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Gmail Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1300, 200],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail account"
        }
      }
    }
  ],

# Copy to .env for the 4-week testnet run:  cp .env.testnet.example .env
PORT=3000
HOST=127.0.0.1
ADMIN_TOKEN=            # generate: openssl rand -hex 32  (REQUIRED if you use docker/a server)

EXECUTION_MODE=testnet
BINANCE_API_KEY=        # from https://testnet.binance.vision (log in with GitHub -> Generate HMAC-SHA-256 Key)
BINANCE_API_SECRET=
LIVE_MAX_TRADE_USD=25
LIVE_MAX_DAILY_LOSS_USD=20
LIVE_MAX_CONSEC_LOSSES=5

# Bot starts itself after a crash/reboot (symbol BTCUSDT, 1-minute candles)
AUTO_START_OBSERVER=on
DAILY_PLAN=on
PLAN_SMALL_COUNT=20
PLAN_MEDIUM_COUNT=20
PLAN_BIG_COUNT=10
PLAN_SMALL_USD=10
PLAN_MEDIUM_USD=25
PLAN_BIG_USD=25
PLAN_RISK_PCT=0.5
PLAN_REWARD_MULT=2
PLAN_MAX_HOLD_MIN=20
PLAN_MIN_GAP_MIN=10

# Optional phone alerts (create a bot with @BotFather, message it, get your id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

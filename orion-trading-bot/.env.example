# --- Server ---
PORT=3000
# 127.0.0.1 = this computer only (safe default). Use 0.0.0.0 only when deploying, and then ALSO set ADMIN_TOKEN.
HOST=127.0.0.1

# Required to start/stop the observer, reset the account or open/close trades from a non-local connection.
# The browser UI sends it from localStorage key "orion_admin_token". Generate: openssl rand -hex 32
ADMIN_TOKEN=

# --- TradingView webhook ---
# No default exists any more: webhook is DISABLED until you set this. Generate: openssl rand -hex 32
# Put the same value in your TradingView alert JSON as "secret".
TRADINGVIEW_WEBHOOK_SECRET=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Daily plan (paper): up to 50 trades/day in 3 sizes, each trade capped at $100 ---
DAILY_PLAN=on
PLAN_SMALL_COUNT=20
PLAN_MEDIUM_COUNT=20
PLAN_BIG_COUNT=10
PLAN_SMALL_USD=10
PLAN_MEDIUM_USD=40
PLAN_BIG_USD=100
PLAN_RISK_PCT=0.5      # stop-loss distance in %, take-profit = this x PLAN_REWARD_MULT
PLAN_REWARD_MULT=2
PLAN_MAX_HOLD_MIN=20   # close any trade still open after this many minutes
PLAN_MIN_GAP_MIN=10    # minimum minutes between entries
# Resume the observer automatically when the server starts
AUTO_START_OBSERVER=off

# =====================================================================
# EXECUTION MODE  (where orders go)
#   paper   = simulated ledger (default, no keys)
#   testnet = REAL orders on Binance Spot Testnet with fake money. DO THIS FIRST for weeks.
#   live    = REAL MONEY on Binance Spot. Also needs LIVE_TRADING_CONFIRM below.
# =====================================================================
EXECUTION_MODE=paper
# Keys live ONLY here (server side). Create the key with "Enable Spot & Margin Trading" and
# WITHOUT withdrawals; restrict it to your server's IP. Testnet keys: https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional override, e.g. a regional endpoint if api.binance.com is blocked where you run the server.
BINANCE_BASE_URL=
# Must be exactly this text to allow EXECUTION_MODE=live:
LIVE_TRADING_CONFIRM=

# --- Hard safety limits for testnet/live (the bot halts entries when any is hit) ---
LIVE_MAX_TRADE_USD=25          # per-trade cap, overrides the daily plan sizes above
LIVE_MAX_DAILY_LOSS_USD=20     # halts new entries until the next local midnight
LIVE_MAX_CONSEC_LOSSES=5       # halts until you press Resume in the Live Trading tab
